# 本地开发与集成环境配置示例。
#
# 用法：cp deploy/compose/.env.example deploy/compose/.env 之后按需修改。
#
# 位置说明：本文件与 docker-compose.yml 同目录，因为 compose 的约定是从
# compose 文件所在目录自动读取 .env，放在这里就不必每次传 --env-file。
# 真实 .env 已被 .gitignore 忽略，禁止把密码、Token 或私钥提交到仓库。
#
# 格式：KEY=VALUE，每行一个，行内不要写注释。取值不要加引号。

# ---------- 应用 ----------
# 取值范围：development / test / staging / production。本机固定使用 development。
APP_ENV=development
# 日志级别。取值范围：trace / debug / info / warn / error。本机建议 debug。
LOG_LEVEL=debug

# ---------- Gateway 监听端口（TASK-004 起使用） ----------
# 取值范围：1-65535。HTTP 与 WebSocket 使用不同端口，避免协议混用。
# 这里是约定值。若本机 8080/8081 已被其它服务占用，网关会启动失败，且请求会被
# 打到占用端口的那个服务上、表现为难以定位的 404。端口冲突属环境问题，处理方式是
# 改用其它端口并在启动时用 -port 显式指定，或使用
# scripts/verify-login.sh（它会预检并自动挑选空闲端口），不要因此改动这里的约定值。
GATEWAY_HTTP_PORT=8080
GATEWAY_WS_PORT=8081

# ---------- Redis ----------
# 宿主机访问地址。容器内访问时使用服务名 redis，见 deploy/compose/README.md。
REDIS_HOST=127.0.0.1
# Redis 在宿主机的映射端口。取值范围：1-65535，需未被占用。默认 6379。
REDIS_PORT=6379

# ---------- MySQL ----------
# 宿主机访问地址。容器内访问时使用服务名 mysql。
MYSQL_HOST=127.0.0.1
# MySQL 在宿主机的映射端口。取值范围：1-65535，需未被占用。默认 3306。
MYSQL_PORT=3306
# 初始化时创建的数据库名。仅允许字母、数字和下划线。
MYSQL_DATABASE=realtime_game
# 业务账号名，仅允许字母、数字和下划线。不要使用 root。
MYSQL_USER=realtime_game
# 业务账号密码。仅用于本地开发，必须替换 change_me。
MYSQL_PASSWORD=change_me
# MySQL root 密码。只在容器首次初始化时生效。
MYSQL_ROOT_PASSWORD=root_change_me

# ---------- 后续阶段（TASK-005 之后启用，当前不启动对应容器） ----------
# Kafka broker 列表，逗号分隔。
KAFKA_BROKERS=127.0.0.1:9092
# etcd 端点列表，逗号分隔。
ETCD_ENDPOINTS=127.0.0.1:2379

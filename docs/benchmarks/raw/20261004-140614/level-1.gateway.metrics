# HELP rgbt_http_requests_total Gateway 处理的 HTTP 请求数，按映射路径与 HTTP 状态码分组
# TYPE rgbt_http_requests_total counter
rgbt_http_requests_total{path="/api/v1/login",status="200"} 1
rgbt_http_requests_total{path="/api/v1/matches",status="200"} 1
rgbt_http_requests_total{path="/api/v1/matches/current",status="200"} 120
# HELP rgbt_rpc_calls_total Gateway 发起的服务间 RPC 调用数
# TYPE rgbt_rpc_calls_total counter
rgbt_rpc_calls_total{target="match",outcome="ok"} 121
# HELP rgbt_push_backfilled_frames 累计补发出去的推送帧数
# TYPE rgbt_push_backfilled_frames gauge
rgbt_push_backfilled_frames 0
# HELP rgbt_push_reset_total 累计发出 stream.reset 的次数，按原因分组
# TYPE rgbt_push_reset_total gauge
rgbt_push_reset_total{reason="id_ahead"} 0
rgbt_push_reset_total{reason="id_current"} 0
rgbt_push_reset_total{reason="id_malformed"} 0
rgbt_push_reset_total{reason="id_out_of_window"} 0
# HELP rgbt_sse_connections 当前 SSE 连接数
# TYPE rgbt_sse_connections gauge
rgbt_sse_connections 0

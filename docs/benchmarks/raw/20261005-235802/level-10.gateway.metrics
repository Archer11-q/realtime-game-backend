# HELP rgbt_http_requests_total Gateway 处理的 HTTP 请求数，按映射路径与 HTTP 状态码分组
# TYPE rgbt_http_requests_total counter
rgbt_http_requests_total{path="/api/v1/login",status="200"} 10
rgbt_http_requests_total{path="/api/v1/matches",status="200"} 20
rgbt_http_requests_total{path="/api/v1/matches/current",status="200"} 830
rgbt_http_requests_total{path="/api/v1/rooms/input",status="200"} 100
rgbt_http_requests_total{path="/api/v1/rooms/join",status="200"} 10
rgbt_http_requests_total{path="/api/v1/stream",status="200"} 10
# HELP rgbt_rpc_calls_total Gateway 发起的服务间 RPC 调用数
# TYPE rgbt_rpc_calls_total counter
rgbt_rpc_calls_total{target="match",outcome="ok"} 850
rgbt_rpc_calls_total{target="room",outcome="failed"} 10
rgbt_rpc_calls_total{target="room",outcome="ok"} 1020
# HELP rgbt_gateway_match_rpc_max_ms Gateway→Match 调用的最大耗时（毫秒）
# TYPE rgbt_gateway_match_rpc_max_ms gauge
rgbt_gateway_match_rpc_max_ms{op="enqueue"} 4
rgbt_gateway_match_rpc_max_ms{op="get_status"} 0
# HELP rgbt_push_backfilled_frames 累计补发出去的推送帧数
# TYPE rgbt_push_backfilled_frames gauge
rgbt_push_backfilled_frames 0
# HELP rgbt_push_reset_total 累计发出 stream.reset 的次数，按原因分组
# TYPE rgbt_push_reset_total gauge
rgbt_push_reset_total{reason="id_ahead"} 0
rgbt_push_reset_total{reason="id_current"} 0
rgbt_push_reset_total{reason="id_malformed"} 0
rgbt_push_reset_total{reason="id_out_of_window"} 0
# HELP rgbt_sse_connections 当前 SSE 连接数
# TYPE rgbt_sse_connections gauge
rgbt_sse_connections 0
# HELP rgbt_sse_oldest_subscription_age_ms 最老 SSE 订阅的年龄（毫秒）
# TYPE rgbt_sse_oldest_subscription_age_ms gauge
rgbt_sse_oldest_subscription_age_ms 0
# HELP rgbt_sse_subscriptions_closed_other_total 因显式取消等原因回收的 SSE 订阅数
# TYPE rgbt_sse_subscriptions_closed_other_total gauge
rgbt_sse_subscriptions_closed_other_total 0
# HELP rgbt_sse_subscriptions_closed_write_failed_total 因写失败回收的 SSE 订阅数
# TYPE rgbt_sse_subscriptions_closed_write_failed_total gauge
rgbt_sse_subscriptions_closed_write_failed_total 10
# HELP rgbt_sse_subscriptions_created_total 累计建立的 SSE 订阅数
# TYPE rgbt_sse_subscriptions_created_total gauge
rgbt_sse_subscriptions_created_total 10
# HELP rgbt_sse_subscriptions_skipped_no_write_total 某一轮里一次写都没有尝试过的订阅数（累计）
# TYPE rgbt_sse_subscriptions_skipped_no_write_total gauge
rgbt_sse_subscriptions_skipped_no_write_total 0

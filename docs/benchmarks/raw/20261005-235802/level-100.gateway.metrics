rgbt_sse_subscriptions_closed_write_failed_total 100
# HELP rgbt_sse_subscriptions_created_total 累计建立的 SSE 订阅数
# TYPE rgbt_sse_subscriptions_created_total gauge
rgbt_sse_subscriptions_created_total 100
